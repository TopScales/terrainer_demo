{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Terrainer Debug (GDExtension)",
            "type": "shell",
            "command": "scons",
            "args": [
                "-j12",
                "platform=windows",
                "target=template_debug",
                "bits=64"
            ],
            "group": "build",
            "presentation": {
                // Reveal the output only if unrecognized errors occur.
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile",
            "options": {
                "cwd": "${workspaceFolder}/libs/gdextension/terrainer",
                "env": {
                    "BIN_OUTPUT": "${workspaceFolder}/libs",
                    "GODOT_BINDINGS": "${workspaceFolder}/libs/gdextension/godot-cpp"
                }
            }
        },
        {
            "label": "Build Terrainer Release (GDExtension)",
            "type": "shell",
            "command": "scons",
            "args": [
                "-j12",
                "platform=windows",
                "target=template_release",
                "bits=64"
            ],
            "group": "build",
            "presentation": {
                // Reveal the output only if unrecognized errors occur.
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile",
            "options": {
                "cwd": "${workspaceFolder}/libs/gdextension/terrainer",
                "env": {
                    "BIN_OUTPUT": "${workspaceFolder}/libs",
                    "GODOT_BINDINGS": "${workspaceFolder}/libs/gdextension/godot-cpp"
                }
            }
        }
    ]
}